---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
const entries = (await getCollection("noticias", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<Base title="Noticias — Calvo Blog" current="noticias"><section class="listing"><p class="eyebrow">Noticias</p><h1>Novedades con fuente y contexto.</h1><p class="listing__lead">Publica cambios que afecten a tus lectores y enlaza siempre a una fuente verificable.</p><div class="articles__grid">{entries.map((entry) => <ArticleCard entry={entry} type="noticias" />)}</div></section></Base>
