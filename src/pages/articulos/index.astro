---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
const entries = (await getCollection("articulos", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<Base title="Artículos — Calvo Blog" current="articulos"><section class="listing"><p class="eyebrow">Artículos</p><h1>Ideas técnicas explicadas sin rodeos.</h1><p class="listing__lead">Contexto, decisiones y conceptos para entender antes de implementar.</p><div class="articles__grid">{entries.map((entry) => <ArticleCard entry={entry} type="articulos" />)}</div></section></Base>
